# Copy to .env for local use. Never commit real values.

# Elasticsearch. Leave empty to use the in-memory store.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# OpenTelemetry (Dash0). Telemetry stays off until the endpoint is set.
# Get the endpoint and auth token from your Dash0 account.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=backchannel-api

PORT=8787
