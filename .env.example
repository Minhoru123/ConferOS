# Copy to .env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional
PORT=3000
# Spoken language for captions, for example en or es.
CAPTION_LANGUAGE=en
# Required from the microphone page when set. Set it whenever the server is reachable by others.
SPEAKER_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Past this, a piece of speech is signed word by word instead of waiting for the model.
SIGN_MODEL_TIMEOUT_MS=4000
